{
  // Cloudflare Worker: guards /app + /api, serves the static build in ./out
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twopixeldev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/app", "/app/*"]
  },
  "kv_namespaces": [
    { "binding": "SITES", "id": "REPLACE_WITH_KV_ID" }
  ],
  // Secrets (set with `npx wrangler secret put`, never committed):
  //   USERS          JSON { "email": "<hash from scripts/hash-password.mjs>" }
  //   SESSION_SECRET random string for signing session cookies
  "routes": [
    { "pattern": "twopixeldev.com", "custom_domain": true },
    { "pattern": "www.twopixeldev.com", "custom_domain": true }
  ]
}
