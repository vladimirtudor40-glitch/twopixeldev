# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Without these the app runs in DEMO mode (any login works, data stays in your browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to true only once Supabase accounts exist. Off = only the animation, /app is not built.
NEXT_PUBLIC_LOGIN_ENABLED=
